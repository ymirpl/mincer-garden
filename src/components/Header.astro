---
interface Props {
  view?: 'mosaic' | 'list' | 'note';
}

const { view = 'mosaic' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const homeHref = base.replace(/\/$/, '') || '/';
---

<header class="site">
  <a class="wordmark" href={homeHref} aria-label="garden.mincer home">
    <span class="sprig" aria-hidden="true">
      <svg class="leaf" width="14" height="14" viewBox="0 0 14 14" fill="none">
        <path d="M2 12 C 4 6, 8 3, 12 2 C 12 7, 9 11, 4 12 Z" />
        <path d="M2.5 11.5 L 9 5" />
      </svg>
    </span>
    garden.mincer
  </a>
  <nav class="views" aria-label="primary">
    <a href={homeHref} class:list={{ active: view === 'mosaic' }} aria-current={view === 'mosaic' ? 'page' : undefined}>mosaic</a>
    <span class="sep" aria-hidden="true">·</span>
    <a href={`${base}list`} class:list={{ active: view === 'list' }} aria-current={view === 'list' ? 'page' : undefined}>notes</a>
  </nav>
</header>
