---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ListIndex from '../../../components/ListIndex.astro';
import { getGardenItems, getTagCounts } from '../../../lib/content';

export async function getStaticPaths() {
  const items = await getGardenItems();
  return getTagCounts(items).map(({ tag }) => ({ params: { tag } }));
}

const { tag } = Astro.params;
const items = (await getGardenItems()).filter((item) => item.tags.includes(tag!));
---

<BaseLayout title={`tag list: ${tag}`} view="list">
  <ListIndex items={items} heading={`tag: ${tag}`} />
</BaseLayout>
