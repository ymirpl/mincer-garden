---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getItemsByType, formatLongDate, itemDate } from '../../lib/content';

export async function getStaticPaths() {
  const items = await getItemsByType('image');
  return items.map((item) => ({ params: { slug: item.slug }, props: { item } }));
}

const { item } = Astro.props;
const { Content } = await render(item.entry);
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const hasBody = (item.body ?? '').trim().length > 0;
let sourceHost = '';
try { sourceHost = new URL(item.externalUrl!).hostname.replace(/^www\./, ''); } catch {}
---

<BaseLayout title={item.title || 'image'} description={item.alt} view="note" bodyClass="artifact-page">
  <main class="artifact i-detail" id="content">
    <nav class="wayfinder" aria-label="breadcrumb">
      <a href={`${base}images`}>← back to images</a>
    </nav>

    <p class="kind image"><span class="dot" aria-hidden="true"></span>image</p>

    {item.image && (
      <figure class="plate">
        <img src={item.image} alt={item.alt ?? ''} />
      </figure>
    )}

    <div class="label">
      {item.caption && <p class="caption">{item.caption}</p>}
      {item.alt && item.alt !== item.caption && <p class="alt">{item.alt}</p>}
    </div>

    {hasBody && (
      <div class="extra">
        <Content />
      </div>
    )}

    <footer class="meta-foot">
      <div class="tag-row">
        {item.tags.map((tag) => (
          <a href={`${base}tags/${tag}`}>#{tag}</a>
        ))}
      </div>
      <div>
        {item.externalUrl && (
          <>
            <a class="src" href={item.externalUrl} rel="noopener" target="_blank">source · {sourceHost}</a>
            <span class="dotsep">·</span>
          </>
        )}
        <span>{formatLongDate(itemDate(item))}</span>
      </div>
    </footer>
  </main>
</BaseLayout>
