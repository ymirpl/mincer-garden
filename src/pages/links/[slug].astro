---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getItemsByType, formatLongDate, itemDate } from '../../lib/content';

export async function getStaticPaths() {
  const items = await getItemsByType('link');
  return items.map((item) => ({ params: { slug: item.slug }, props: { item } }));
}

const { item } = Astro.props;
const { Content } = await render(item.entry);
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');

let urlScheme = '';
let urlRest = item.externalUrl ?? '';
try {
  const u = new URL(item.externalUrl!);
  urlScheme = `${u.protocol}//`;
  urlRest = `${u.host}${u.pathname}${u.search}${u.hash}`.replace(/\/$/, '');
} catch {}
---

<BaseLayout title={item.title} description={item.excerpt} view="note" bodyClass="artifact-page">
  <main class="artifact l-detail" id="content">
    <div class="wayfinder">
      <a href={base}>← garden</a>
      <span class="sep" aria-hidden="true"> / </span>
      <a href={`${base}links`}>links</a>
    </div>

    <p class="kind link"><span class="dot" aria-hidden="true"></span>link · {item.domain}</p>
    <h1 class="title">{item.title}</h1>
    <p class="url-line"><span class="scheme">{urlScheme}</span>{urlRest}</p>

    <a class="visit" href={item.externalUrl} rel="noopener" target="_blank">
      <span>open at {item.domain}</span>
      <span class="arrow" aria-hidden="true">→</span>
    </a>

    {item.image && (
      <figure class="snapshot" aria-hidden="true">
        <img src={item.image} alt="" loading="lazy" />
      </figure>
    )}

    <div class="annotation">
      <span class="ornament" aria-hidden="true">
        <svg width="16" height="16" viewBox="0 0 14 14" fill="none">
          <path d="M2 12 C 4 6, 8 3, 12 2 C 12 7, 9 11, 4 12 Z" stroke="currentColor" stroke-width="0.85" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
          <path d="M2.5 11.5 L 9 5" stroke="currentColor" stroke-width="0.85" stroke-linecap="round"/>
        </svg>
      </span>
      <Content />
    </div>

    <footer class="meta-foot">
      <div class="tag-row">
        {item.tags.map((tag) => (
          <a href={`${base}tags/${tag}`}>#{tag}</a>
        ))}
      </div>
      <div>tended {formatLongDate(itemDate(item))}</div>
    </footer>
  </main>
</BaseLayout>
