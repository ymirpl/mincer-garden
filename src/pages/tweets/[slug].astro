---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getItemsByType, formatLongDate, itemDate } from '../../lib/content';

export async function getStaticPaths() {
  const items = await getItemsByType('tweet');
  return items.map((item) => ({ params: { slug: item.slug }, props: { item } }));
}

const { item } = Astro.props;
const { Content } = await render(item.entry);
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
let sourceHost = '';
try { sourceHost = new URL(item.externalUrl!).hostname.replace(/^www\./, ''); } catch {}
---

<BaseLayout title={item.excerpt.slice(0, 60)} description={item.excerpt} view="note" bodyClass="artifact-page">
  <main class="artifact t-detail" id="content">
    <div class="wayfinder">
      <a href={base}>← garden</a>
      <span class="sep" aria-hidden="true"> / </span>
      <a href={`${base}tweets`}>tweets</a>
    </div>

    <p class="kind tweet"><span class="dot" aria-hidden="true"></span>tweet</p>

    <span class="sprig" aria-hidden="true">
      <svg viewBox="0 0 28 28" fill="none">
        <path d="M4 24 C 8 12, 16 6, 24 4 C 24 14, 18 22, 8 24 Z" stroke="currentColor" stroke-width="0.9" stroke-linecap="round" stroke-linejoin="round" fill="none"/>
        <path d="M5 23 L 18 10" stroke="currentColor" stroke-width="0.9" stroke-linecap="round"/>
      </svg>
    </span>

    <div class="body">
      <Content />
    </div>

    <footer class="meta-foot tweet-foot">
      <div class="tag-row">
        {item.tags.map((tag) => (
          <a href={`${base}tags/${tag}`}>#{tag}</a>
        ))}
      </div>
      <div>
        {item.externalUrl && (
          <>
            <a class="src" href={item.externalUrl} rel="noopener" target="_blank">via {sourceHost}</a>
            <span class="dotsep">·</span>
          </>
        )}
        <span>{formatLongDate(itemDate(item))}</span>
      </div>
    </footer>
  </main>
</BaseLayout>
