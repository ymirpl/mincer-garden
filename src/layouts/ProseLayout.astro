---
import BaseLayout from './BaseLayout.astro';
import StatusMark from '../components/StatusMark.astro';
import type { GardenItem } from '../lib/content';
import { formatLongDate, itemDate, noteLayout } from '../lib/content';

interface Props {
  item: GardenItem;
}

const { item } = Astro.props;
const layout = noteLayout(item);
const isNote = item.type === 'note';
const base = import.meta.env.BASE_URL.replace(/\/?$/, '/');
const detailIndexHref = item.type === 'note' ? `${base}list` : `${base}${item.type}s`;
const detailIndexLabel = item.type === 'note' ? 'notes' : `${item.type}s`;
---

<BaseLayout title={item.title} description={item.excerpt} view="note" bodyClass={`prose-page ${layout}`}>
  <main class="note-shell" id="content">
    {isNote && (
      <aside class="note-meta" aria-label="note metadata">
        <p>planted {formatLongDate(item.created)}</p>
        <p>tended {formatLongDate(itemDate(item))}</p>
      </aside>
    )}
    <article class:list={['prose', layout]}>
      <div class="prose-head">
        <nav class="wayfinder" aria-label="breadcrumb">
          <a href={detailIndexHref}>← back to {detailIndexLabel}</a>
        </nav>
        <p class:list={['kind', item.type, item.status]}>
          <span class="dot" aria-hidden="true"></span>{item.type}
          {item.status && (<><span class="kind-sep" aria-hidden="true">·</span><StatusMark status={item.status} />{item.status}</>)}
        </p>
        {layout === 'long' ? (
          <header class="note-title">
            <h1>{item.title}</h1>
            {'subtitle' in item.entry.data && item.entry.data.subtitle && <p>{item.entry.data.subtitle}</p>}
          </header>
        ) : (
          <header class="fragment-title">
            <h1>{item.title}</h1>
          </header>
        )}
      </div>
      <slot />
      <footer class="meta-foot prose-foot">
        <div class="tag-row">
          {item.tags.map((tag) => (
            <a href={`${base}tags/${tag}`}>#{tag}</a>
          ))}
        </div>
        <div>tended {formatLongDate(itemDate(item))}</div>
      </footer>
    </article>
  </main>
</BaseLayout>
